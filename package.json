{
  "name": "umblaetterer",
  "version": "1.0.0",
  "description": "Ein Feuilleton auf Papier — the WordPress theme for Der Umblätterer.",
  "author": "Mark Schwindt",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Theme"
  ],
  "homepage": "https://github.com/markschwindt/umblaetterer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markschwindt/umblaetterer.git"
  },
  "bugs": {
    "url": "https://github.com/markschwindt/umblaetterer/issues"
  },
  "devDependencies": {
    "@wordpress/scripts": "^19.2.2",
    "dir-archiver": "^1.1.1",
    "rtlcss": "^3.5.0",
    "sass": "^1.99.0"
  },
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "scripts": {
    "watch": "sass --watch --no-source-map --style=expanded sass/style.scss:style.css",
    "compile:css": "sass --no-source-map --style=expanded sass/style.scss:style.css && stylelint 'style.css' --fix",
    "compile:rtl": "rtlcss style.css style-rtl.css",
    "lint:scss": "wp-scripts lint-style 'sass/**/*.scss'",
    "lint:js": "wp-scripts lint-js 'js/*.js'",
    "bundle": "dir-archiver --src . --dest ../umblaetterer.zip --exclude .DS_Store .stylelintrc.json .eslintrc .git .gitattributes .github .gitignore README.md composer.json composer.lock node_modules vendor package-lock.json package.json .travis.yml phpcs.xml.dist sass style.css.map yarn.lock",
    "compile:editor": "sass --no-source-map --style=expanded sass/editor.scss:assets/css/editor.css && stylelint 'assets/css/editor.css' --fix"
  }
}
